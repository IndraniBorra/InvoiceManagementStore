# Backend Environment Variables — copy this file to .env and fill in real values
# Never commit .env — only commit this .env.example file

# Anthropic (AI Assistant)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AWS Cognito (Auth)
COGNITO_POOL_ID=us-east-1_YourPoolId
COGNITO_CLIENT_ID=your-client-id-here

# Plaid (Bank Integration)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Database (leave empty for local SQLite, set for production PostgreSQL)
DATABASE_URL=postgresql://smartinvoice_admin:yourpassword@your-rds-endpoint:5432/smartinvoice?sslmode=require

# App Settings
DEBUG_MODE=false
LOG_LEVEL=INFO

# AWS Credentials (local dev only — use IAM roles in production)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
