# Frontend Environment Variables — copy this file to .env and fill in real values
# Never commit .env — only commit this .env.example file

# Backend API URL (local dev: http://localhost:8000, production: your API Gateway URL)
REACT_APP_API_URL=http://localhost:8000

# AWS Cognito (Auth) — get these after running the Terraform infra workflow
REACT_APP_COGNITO_POOL_ID=us-east-1_YourPoolId
REACT_APP_COGNITO_CLIENT_ID=your-client-id-here
